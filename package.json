{
  "name": "@moonjellydigital/pride-flags",
  "description": "Pride flags CSS",
  "version": "1.2.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "Camille Spain <camille@camillespain.com>",
  "license": "MIT",
  "keywords": [
    "pride flag",
    "pride",
    "CSS"
  ],
  "homepage": "https://github.com/moonjellydigital/pride-flags",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonjellydigital/pride-flags.git"
  },
  "files": [
    "./pride-flags.css",
    "./CHANGELOG.md"
  ],
  "main": "pride-flags.css",
  "style": "pride-flags.css",
  "scripts": {
    "prepare": "husky || true",
    "astro:ci": "astro check",
    "fmt:ci": "bunx prettier --check .",
    "lint:ts:ci": "bunx eslint .",
    "lint:css:ci": "bunx stylelint .",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "lint-staged": {
    "*.{json,yml,yaml,md}": "prettier --write",
    "*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.astro": [
      "prettier --write",
      "stylelint --fix"
    ]
  },
  "type": "module",
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/mdx": "4.2.6",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^9.39.5",
    "@moonjellydigital/prettier-config": "^1.1.0",
    "@types/bun": "^1.4.3",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/prettier": "^3.0.0",
    "astro": "5.7.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.8.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "modern-normalize": "^3.0.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
